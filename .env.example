# Non-spark notebook configuration. Never commit .env or customer files.
# Databricks Runtime notebooks have their own configuration and secret-scope cells.

# Local folder or abfss://<filesystem>@<account>.dfs.core.windows.net/claims/<claim-id>.
# Configure Volume paths in the Databricks Runtime notebooks instead.
CLAIM_FOLDER=data/claims/claim-001
# Keep CU and DI outputs separate and outside the input folder.
CU_OUTPUT_ROOT=output/claims/cu
DI_OUTPUT_ROOT=output/claims/di

# Existing, approved resources. DI does not require a CU endpoint.
DOCUMENTINTELLIGENCE_ENDPOINT=
DI_API_VERSION=2024-11-30
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
# Existing, approved GPT-5 vision deployment used only by the DI visual step.
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5.2
AZURE_SEARCH_SERVICE_ENDPOINT=
# Choose a separate index per participant; do not use an agent-managed index.
AZURE_SEARCH_CU_INDEX_NAME=claims-cu-v1
AZURE_SEARCH_DI_INDEX_NAME=claims-di-v1

# DefaultAzureCredential uses your local sign-in or the service principal below.
# Optional: restrict DefaultAzureCredential to the Azure CLI identity.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential

# Optional local service-principal authentication; never fill these in this example.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Content Understanding notebooks; use only where the service is approved.
APP_CONTENT_UNDERSTANDING_ENDPOINT=
CU_API_VERSION=2025-11-01
